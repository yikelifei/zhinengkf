generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SkuType {
  gift_box
  item
  accessory
}

enum ConversationChannel {
  wechat
  personal_wechat
  work_wechat
  xiaohongshu
  douyin
}

enum MessageDirection {
  inbound
  outbound
  system
}

enum DesignJobStatus {
  draft
  submitted
  generating
  completed
  quick_confirm
  manual_review
  sent
  customer_selected
  quote_created
  failed
  timeout
  cancelled
}

enum DesignPlatformExecutionStatus {
  prepared
  dispatching
  generating
  completed
  explicit_failed
  outcome_unknown
  cancel_requested
  cancelled
}

enum DesignPlatformAcceptanceStatus {
  pending
  accepting
  accepted
  rejected
  manual_review
}

enum DesignPlatformRefundStatus {
  pending
  refunded
  not_required
  credit_bypass
  failed
  unknown
}

enum QuoteStatus {
  draft
  auto_sent
  send_queued
  manual_review
  sent
  accepted
  rejected
  cancelled
}

enum PaymentStatus {
  unpaid
  deposit_paid
  paid
  refunded
}

enum SendTaskStatus {
  queued
  sending
  dry_run
  sent
  failed
  blocked
  cancelled
}

enum SendAttemptStatus {
  started
  dry_run
  sent
  failed
  blocked
}

model WechatAccount {
  id                            String                     @id @default(cuid())
  displayName                   String
  alias                         String?
  personalWechatOwnerWxId       String?                    @unique
  personalWechatAccountNickname String?
  windowHandle                  String?
  processId                     Int?
  isActive                      Boolean                    @default(true)
  lastSeenAt                    DateTime?
  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime                   @updatedAt
  conversations                 Conversation[]
  designJobs                    DesignJob[]
  sendTasks                     WechatSendTask[]
  orderDrafts                   OrderDraft[]
  windowSnapshots               WechatWindowSnapshot[]
  wechatWorkBindings            WechatWorkBinding[]
  personalWechatRpaBindings     PersonalWechatRpaBinding[]

  @@index([isActive, displayName])
}

model Customer {
  id                          String                     @id @default(cuid())
  name                        String
  avatarUrl                   String?
  wechatId                    String?
  personalWechatRpaBindingKey String?                    @unique
  phone                       String?
  tags                        Json?
  notes                       String?
  source                      String?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  conversations               Conversation[]
  designJobs                  DesignJob[]
  quoteDrafts                 QuoteDraft[]
  orderDrafts                 OrderDraft[]
  wechatWorkBindings          WechatWorkBinding[]
  personalWechatRpaBindings   PersonalWechatRpaBinding[]

  @@index([wechatId])
}

model Conversation {
  id                        String                     @id @default(cuid())
  channel                   ConversationChannel        @default(wechat)
  externalChatId            String?
  title                     String
  customerId                String
  wechatAccountId           String?
  lastMessageAt             DateTime?
  manualLocked              Boolean                    @default(false)
  assignee                  String?
  priority                  String                     @default("normal")
  status                    String                     @default("open")
  slaDueAt                  DateTime?
  firstResponseDueAt        DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  customer                  Customer                   @relation(fields: [customerId], references: [id])
  wechatAccount             WechatAccount?             @relation(fields: [wechatAccountId], references: [id])
  messages                  Message[]
  designJobs                DesignJob[]
  sendTasks                 WechatSendTask[]
  orderDrafts               OrderDraft[]
  activeWindowSnapshots     WechatWindowSnapshot[]     @relation("ActiveConversationWindowSnapshots")
  wechatWorkBindings        WechatWorkBinding[]
  personalWechatRpaBindings PersonalWechatRpaBinding[]

  @@unique([wechatAccountId, externalChatId])
  @@index([customerId])
  @@index([wechatAccountId])
  @@index([channel, lastMessageAt])
  @@index([wechatAccountId, status, priority, lastMessageAt])
  @@index([assignee, status, lastMessageAt])
  @@index([slaDueAt])
  @@index([firstResponseDueAt])
}

model WechatWorkBinding {
  id              String        @id @default(cuid())
  openKfid        String
  externalUserId  String
  wechatAccountId String
  customerId      String
  conversationId  String
  lastInboundAt   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  wechatAccount   WechatAccount @relation(fields: [wechatAccountId], references: [id])
  customer        Customer      @relation(fields: [customerId], references: [id])
  conversation    Conversation  @relation(fields: [conversationId], references: [id])

  @@unique([openKfid, externalUserId])
  @@unique([conversationId])
  @@index([wechatAccountId, customerId])
}

model WechatWorkAuditLog {
  id              String   @id @default(cuid())
  action          String
  status          String
  msgid           String?
  callbackId      String?
  event           String?
  openKfid        String?
  externalUserId  String?
  wechatAccountId String?
  customerId      String?
  conversationId  String?
  messageId       String?
  sendTaskId      String?
  sendAttemptId   String?
  errorMessage    String?
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([msgid])
  @@index([action, createdAt])
  @@index([sendTaskId, createdAt])
  @@index([openKfid, externalUserId, createdAt])
}

model WechatWorkCustomerUpgrade {
  id                  String    @id
  corpId              String
  openKfid            String
  externalUserId      String
  wechatAccountId     String
  conversationId      String
  customerId          String
  memberUserId        String
  state               String    @unique
  configId            String?
  qrCodeUrl           String?
  localPath           String?
  status              String
  claimToken          String?
  claimExpiresAt      DateTime?
  textStatus          String    @default("pending")
  imageStatus         String    @default("pending")
  textMsgId           String?
  imageMsgId          String?
  sendTaskId          String?
  sendAttemptId       String?
  apiAcceptedAt       DateTime?
  asyncFailedAt       DateTime?
  sourceUnionId       String?
  addedExternalUserId String?
  halfAddedAt         DateTime?
  identityVerifiedAt  DateTime?
  addedAt             DateTime?
  errorMessage        String?
  version             Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([corpId, openKfid, externalUserId, memberUserId])
  @@index([sendTaskId])
  @@index([textMsgId])
  @@index([imageMsgId])
  @@index([status, updatedAt])
}

model PersonalWechatRpaBinding {
  id               String        @id @default(cuid())
  bindingKey       String        @unique
  ownerWxId        String
  accountNickname  String
  chatTitle        String
  conversationType String
  senderName       String?
  wechatAccountId  String
  customerId       String
  conversationId   String        @unique
  lastInboundAt    DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  wechatAccount    WechatAccount @relation(fields: [wechatAccountId], references: [id])
  customer         Customer      @relation(fields: [customerId], references: [id])
  conversation     Conversation  @relation(fields: [conversationId], references: [id])

  @@index([wechatAccountId, lastInboundAt])
  @@index([ownerWxId])
}

model PersonalWechatRpaAuditLog {
  id              String   @id @default(cuid())
  direction       String
  status          String
  reason          String?
  accountNickname String?
  ownerWxId       String?
  chatTitle       String?
  externalId      String?
  wechatAccountId String?
  customerId      String?
  conversationId  String?
  messageId       String?
  sendTaskId      String?
  errorMessage    String?
  createdAt       DateTime @default(now())

  @@index([wechatAccountId, createdAt])
  @@index([conversationId, externalId, createdAt])
  @@index([direction, status, createdAt])
}

model InboundMessageOperation {
  id                 String    @id
  source             String
  wechatAccountId    String
  externalId         String
  requestFingerprint String
  normalizedPayload  Json?
  status             String    @default("processing")
  stage              String    @default("reserved")
  bindingKey         String?
  customerId         String?
  conversationId     String?
  messageId          String?
  routeEvaluationId  String?
  sendTaskId         String?
  result             Json?
  claimToken         String?
  leaseExpiresAt     DateTime?
  attemptCount       Int       @default(1)
  lastError          String?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([wechatAccountId, externalId])
  @@index([status, leaseExpiresAt])
  @@index([stage, updatedAt])
}

model WechatWorkSyncCursor {
  id                   String   @id @default(cuid())
  openKfid             String   @unique
  nextCursor           String   @default("")
  terminalMessageCount Int      @default(0)
  batchFingerprint     String?
  committedAt          DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([committedAt])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  text           String?
  attachments    Json?
  metadata       Json?
  externalId     String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  conversation   Conversation     @relation(fields: [conversationId], references: [id])

  @@unique([conversationId, externalId])
  @@index([conversationId, createdAt])
  @@index([externalId])
}

model Sku {
  id                  String         @id @default(cuid())
  skuCode             String         @unique
  name                String
  type                SkuType
  category            String?
  sceneTags           Json?
  costPrice           Decimal        @db.Decimal(12, 2)
  salePrice           Decimal        @db.Decimal(12, 2)
  profitRate          Decimal?       @db.Decimal(8, 4)
  stock               Int            @default(0)
  dimensions          Json?
  weightGram          Int?
  material            String?
  supplier            String?
  leadTimeDays        Int?
  mainImagePath       String?
  angleImages         Json?
  matchingRules       Json?
  replacementSkuCodes Json?
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  changeLogs          SkuChangeLog[]
}

model SkuChangeLog {
  id            String   @id @default(cuid())
  skuId         String
  skuCode       String
  name          String
  action        String
  source        String
  operator      String
  reason        String
  changedFields Json
  before        Json?
  after         Json
  createdAt     DateTime @default(now())
  sku           Sku      @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@index([skuCode, createdAt])
  @@index([createdAt])
}

model DesignAsset {
  id                  String      @id @default(cuid())
  ownerType           String
  ownerId             String
  fileName            String
  mimeType            String
  localPath           String
  normalizedLocalPath String?     @unique
  sizeBytes           Int?
  role                String?
  source              String
  wechatAccountId     String?
  conversationId      String?
  customerId          String?
  createdAt           DateTime    @default(now())
  designJobs          DesignJob[] @relation("DesignJobAssets")

  @@index([ownerType, ownerId])
  @@index([wechatAccountId, conversationId, customerId])
}

model DesignJob {
  id                         String                    @id @default(cuid())
  requestId                  String                    @unique
  externalJobId              String?
  status                     DesignJobStatus           @default(draft)
  designType                 String                    @default("bundle_render")
  renderStyle                String                    @default("真实产品摆拍")
  outputCount                Int                       @default(6)
  budget                     Json
  bundle                     Json
  requirements               Json
  customerText               String?
  scene                      String?
  isHighValue                Boolean                   @default(false)
  manualQcRequired           Boolean                   @default(true)
  retryCount                 Int                       @default(0)
  revisionCount              Int                       @default(0)
  revisionPolicy             Json?
  errorMessage               String?
  waitMessageSentAt          DateTime?
  submitOperationKey         String?                   @unique
  submitRequestFingerprint   String?
  submitOperationIdentity    Json?
  submitDispatchStatus       String?
  submitDispatchError        String?
  callbackOperationKey       String?                   @unique
  callbackRequestFingerprint String?
  callbackStatus             String?
  callbackClaimedAt          DateTime?
  callbackSettledAt          DateTime?
  submittedAt                DateTime?
  completedAt                DateTime?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  customerId                 String
  conversationId             String
  wechatAccountId            String?
  orderId                    String?
  customer                   Customer                  @relation(fields: [customerId], references: [id])
  conversation               Conversation              @relation(fields: [conversationId], references: [id])
  wechatAccount              WechatAccount?            @relation(fields: [wechatAccountId], references: [id])
  assets                     DesignAsset[]             @relation("DesignJobAssets")
  images                     DesignImageCandidate[]
  revisions                  DesignRevision[]
  quoteDrafts                QuoteDraft[]
  orderDrafts                OrderDraft[]
  sendTasks                  WechatSendTask[]
  platformExecutions         DesignPlatformExecution[]

  @@index([status, createdAt])
  @@index([customerId])
  @@index([conversationId])
}

model DesignImageCandidate {
  id                 String           @id @default(cuid())
  imageId            String
  designJobId        String
  position           Int
  downloadUrl        String?
  localPath          String?
  width              Int?
  height             Int?
  fingerprint        String?
  legacyIdentityHash String?
  selected           Boolean          @default(false)
  customerFeedback   String?
  createdAt          DateTime         @default(now())
  designJob          DesignJob        @relation(fields: [designJobId], references: [id])
  revisionRequests   DesignRevision[]
  quoteDrafts        QuoteDraft[]
  orderDrafts        OrderDraft[]

  @@unique([designJobId, imageId])
  @@index([designJobId, position])
}

model DesignRevision {
  id                   String                    @id @default(cuid())
  designJobId          String
  selectedImageId      String?
  revisionNumber       Int
  instruction          String                    @db.Text
  sourceText           String?                   @db.Text
  policyAction         String
  status               String                    @default("requested")
  retryCount           Int                       @default(0)
  chargeRequired       Boolean                   @default(false)
  manualReviewRequired Boolean                   @default(false)
  externalJobId        String?
  operationKey         String?                   @unique
  requestFingerprint   String?
  operationIdentity    Json?
  externalRequestId    String?                   @unique
  dispatchStatus       String?
  dispatchError        String?
  waitMessageSentAt    DateTime?
  resultImageIds       Json?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  designJob            DesignJob                 @relation(fields: [designJobId], references: [id])
  selectedImage        DesignImageCandidate?     @relation(fields: [selectedImageId], references: [id])
  platformExecutions   DesignPlatformExecution[]

  @@unique([designJobId, revisionNumber])
  @@index([designJobId, createdAt])
  @@index([status, createdAt])
}

model DesignPlatformExecution {
  id                 String                         @id @default(cuid())
  operationKey       String                         @unique
  externalJobId      String                         @unique
  requestId          String                         @unique
  scopeKey           String
  adapter            String                         @default("art_image_local")
  designJobId        String
  designRevisionId   String?
  attemptNo          Int
  processRunId       String
  status             DesignPlatformExecutionStatus  @default(prepared)
  acceptanceStatus   DesignPlatformAcceptanceStatus @default(pending)
  refundStatus       DesignPlatformRefundStatus     @default(pending)
  imageCount         Int                            @default(0)
  images             Json?
  refundSummary      Json?
  errorCode          String?
  errorCategory      String?
  errorMessage       String?
  responseHttpStatus Int?
  dispatchedAt       DateTime?
  acceptedAt         DateTime?
  completedAt        DateTime?
  resolvedAt         DateTime?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  designJob          DesignJob                      @relation(fields: [designJobId], references: [id], onDelete: Restrict)
  designRevision     DesignRevision?                @relation(fields: [designRevisionId], references: [id], onDelete: Restrict)

  @@unique([designJobId, designRevisionId, attemptNo])
  @@index([status, processRunId, updatedAt])
  @@index([scopeKey, attemptNo])
  @@index([designJobId, createdAt])
  @@index([acceptanceStatus, completedAt])
}

model QuoteDraft {
  id              String                @id @default(cuid())
  designJobId     String
  customerId      String
  selectedImageId String?
  quantity        Int
  unitPrice       Decimal               @db.Decimal(12, 2)
  totalPrice      Decimal               @db.Decimal(12, 2)
  totalCost       Decimal               @db.Decimal(12, 2)
  profit          Decimal               @db.Decimal(12, 2)
  status          QuoteStatus           @default(draft)
  paymentStatus   PaymentStatus         @default(unpaid)
  sendTaskId      String?
  customerNotes   String?
  owner           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  designJob       DesignJob             @relation(fields: [designJobId], references: [id])
  customer        Customer              @relation(fields: [customerId], references: [id])
  selectedImage   DesignImageCandidate? @relation(fields: [selectedImageId], references: [id])
  orderDraft      OrderDraft?
  paymentEvents   PaymentEvent[]

  @@index([status, createdAt])
  @@index([sendTaskId])
}

model OrderDraft {
  id                    String                @id @default(cuid())
  quoteDraftId          String                @unique
  designJobId           String
  customerId            String
  conversationId        String
  wechatAccountId       String
  selectedImageId       String?
  quantity              Int
  unitPrice             Decimal               @db.Decimal(12, 2)
  totalPrice            Decimal               @db.Decimal(12, 2)
  totalCost             Decimal               @db.Decimal(12, 2)
  profit                Decimal               @db.Decimal(12, 2)
  status                String                @default("draft")
  paymentStatus         PaymentStatus         @default(unpaid)
  productionStatus      String                @default("not_started")
  productionDueAt       String?
  carrier               String?
  trackingNo            String?
  shippedAt             String?
  deliveredAt           String?
  bundleSnapshot        Json?
  selectedImageSnapshot Json?
  customerNotes         String?
  owner                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  quoteDraft            QuoteDraft            @relation(fields: [quoteDraftId], references: [id])
  designJob             DesignJob             @relation(fields: [designJobId], references: [id])
  customer              Customer              @relation(fields: [customerId], references: [id])
  conversation          Conversation          @relation(fields: [conversationId], references: [id])
  wechatAccount         WechatAccount         @relation(fields: [wechatAccountId], references: [id])
  selectedImage         DesignImageCandidate? @relation(fields: [selectedImageId], references: [id])
  paymentEvents         PaymentEvent[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([designJobId])
  @@index([productionStatus, updatedAt])
}

model PaymentEvent {
  id              String        @id @default(cuid())
  quoteDraftId    String
  orderDraftId    String?
  customerId      String
  conversationId  String?
  wechatAccountId String?
  paymentStatus   PaymentStatus
  amountCny       Decimal?      @db.Decimal(12, 2)
  method          String?
  proofReference  String?
  reviewer        String?
  note            String?
  source          String        @default("manual_payment_proof")
  idempotencyKey  String        @unique
  createdAt       DateTime      @default(now())
  quoteDraft      QuoteDraft    @relation(fields: [quoteDraftId], references: [id])
  orderDraft      OrderDraft?   @relation(fields: [orderDraftId], references: [id])

  @@index([quoteDraftId, createdAt])
  @@index([orderDraftId, createdAt])
  @@index([customerId, createdAt])
}

model WechatSendTask {
  id              String              @id @default(cuid())
  status          SendTaskStatus      @default(queued)
  wechatAccountId String
  conversationId  String
  designJobId     String?
  quoteDraftId    String?
  payload         Json
  guardSnapshot   Json?
  errorMessage    String?
  queuedAt        DateTime            @default(now())
  sentAt          DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  wechatAccount   WechatAccount       @relation(fields: [wechatAccountId], references: [id])
  conversation    Conversation        @relation(fields: [conversationId], references: [id])
  designJob       DesignJob?          @relation(fields: [designJobId], references: [id])
  attempts        WechatSendAttempt[]

  @@index([wechatAccountId, status])
  @@index([conversationId, status])
  @@index([status, queuedAt])
  @@index([quoteDraftId])
}

model WechatSendAttempt {
  id               String                @id @default(cuid())
  sendTaskId       String
  adapter          String
  status           SendAttemptStatus     @default(started)
  guardStatus      String?
  windowSnapshotId String?
  payloadSummary   Json?
  errorMessage     String?
  metadata         Json?
  startedAt        DateTime              @default(now())
  completedAt      DateTime?
  createdAt        DateTime              @default(now())
  sendTask         WechatSendTask        @relation(fields: [sendTaskId], references: [id])
  windowSnapshot   WechatWindowSnapshot? @relation(fields: [windowSnapshotId], references: [id], onDelete: SetNull)

  @@index([sendTaskId, startedAt])
  @@index([status, startedAt])
  @@index([windowSnapshotId])
}

model WechatWindowSnapshot {
  id                   String              @id @default(cuid())
  source               String
  isOnline             Boolean             @default(true)
  wechatAccountId      String?
  activeConversationId String?
  accountDisplayName   String?
  windowHandle         String?
  processId            Int?
  chatTitle            String?
  activeChatTitle      String?
  externalChatId       String?
  recentCustomerId     String?
  recentMessageText    String?
  confidence           Decimal?            @db.Decimal(4, 3)
  diagnostic           Json?
  raw                  Json?
  capturedAt           DateTime            @default(now())
  createdAt            DateTime            @default(now())
  wechatAccount        WechatAccount?      @relation(fields: [wechatAccountId], references: [id])
  activeConversation   Conversation?       @relation("ActiveConversationWindowSnapshots", fields: [activeConversationId], references: [id], onDelete: SetNull)
  sendAttempts         WechatSendAttempt[]

  @@index([wechatAccountId, capturedAt])
  @@index([activeConversationId, capturedAt])
  @@index([recentCustomerId, capturedAt])
  @@index([isOnline, capturedAt])
}

model Notification {
  id        String    @id @default(cuid())
  level     String
  title     String
  body      String?
  target    Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model ReviewLog {
  id           String   @id @default(cuid())
  targetType   String
  targetId     String
  decision     String
  reviewer     String
  note         String?
  beforeStatus String?
  afterStatus  String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([targetType, targetId])
  @@index([decision, createdAt])
}

model AgentTask {
  id               String             @id
  operationKey     String             @unique
  status           String             @default("created")
  taskType         String
  lane             String?
  routeAction      String?
  planType         String?
  reason           String?
  objective        String?            @db.Text
  wechatAccountId  String?
  conversationId   String?
  customerId       String?
  routeId          String?
  inboundMessageId String?
  currentStep      String?
  payload          Json?
  handoff          Json?
  errorCode        String?
  errorMessage     String?
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  steps            AgentTaskStep[]
  approvals        AgentTaskApproval[]
  toolExecutions   AgentTaskToolExecution[]

  @@index([conversationId, status, updatedAt])
  @@index([customerId, updatedAt])
  @@index([wechatAccountId, status, updatedAt])
  @@index([status, updatedAt])
}

model AgentTaskStep {
  id             String    @id
  taskId         String
  stepKey        String
  status         String    @default("planned")
  mode           String?
  toolName       String?
  idempotencyKey String?
  input          Json?
  output         Json?
  verification   Json?
  errorCode      String?
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  task           AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, stepKey])
  @@index([taskId, status])
  @@index([toolName, status, updatedAt])
}

model AgentTaskApproval {
  id             String    @id
  taskId         String
  status         String    @default("pending")
  policy         String
  requestedBy    String?
  reviewer       String?
  decisionNote   String?
  metadata       Json?
  requestedAt    DateTime  @default(now())
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  task           AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, status])
  @@index([status, requestedAt])
}

model AgentTaskToolExecution {
  id             String    @id
  taskId         String
  stepKey        String?
  operationKey   String    @unique
  toolName       String
  toolVersion    String    @default("1")
  effect         String
  capability     String?
  status         String    @default("planned")
  idempotencyKey String?
  input          Json?
  output         Json?
  errorCode      String?
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  task           AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, status, updatedAt])
  @@index([toolName, status, updatedAt])
  @@index([idempotencyKey])
}

model CustomerServiceAgent {
  id               String            @id @default(cuid())
  key              String            @unique
  name             String
  scene            String
  description      String?
  valueLevel       String?
  enabled          Boolean           @default(true)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  skills           AgentSkill[]
  chatImports      ChatImport[]
  trainingSamples  TrainingSample[]
  knowledgeEntries KnowledgeEntry[]
  routeEvaluations RouteEvaluation[]
}

model AgentSkill {
  id              String               @id @default(cuid())
  agentId         String
  name            String
  description     String?
  enabled         Boolean              @default(true)
  version         Int                  @default(1)
  sourceType      String?
  sourceSampleIds Json?
  sampleCount     Int                  @default(0)
  confidence      Int                  @default(0)
  lastCompiledAt  DateTime?
  wechatAccountId String?
  conversationId  String?
  customerId      String?
  identityBinding Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  agent           CustomerServiceAgent @relation(fields: [agentId], references: [id])

  @@index([agentId])
  @@index([agentId, wechatAccountId, conversationId, customerId])
}

model ChatImport {
  id              String                @id @default(cuid())
  name            String
  source          String
  channel         String
  agentId         String?
  rawText         String                @db.Text
  messageCount    Int                   @default(0)
  pairCount       Int                   @default(0)
  warnings        Json?
  customerId      String?
  conversationId  String?
  wechatAccountId String?
  identityBinding Json?
  sceneSummary    Json?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  agent           CustomerServiceAgent? @relation(fields: [agentId], references: [id])
  samples         TrainingSample[]

  @@index([agentId])
  @@index([createdAt])
  @@index([wechatAccountId, conversationId, customerId, createdAt])
}

model TrainingSample {
  id               String                @id @default(cuid())
  importId         String?
  agentId          String?
  agentKey         String
  scene            String
  customerText     String                @db.Text
  idealReply       String                @db.Text
  score            Int                   @default(0)
  status           String                @default("review")
  skillHints       Json?
  sourceLineStart  Int?
  sourceLineEnd    Int?
  customerId       String?
  conversationId   String?
  wechatAccountId  String?
  identityBinding  Json?
  sceneScore       Int                   @default(0)
  sceneScores      Json?
  matchedKeywords  Json?
  sceneCheck       Json?
  sourceType       String?
  sourceRouteId    String?
  reviewer         String?
  reviewNote       String?
  reviewedAt       DateTime?
  reviewHistory    Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  import           ChatImport?           @relation(fields: [importId], references: [id])
  agent            CustomerServiceAgent? @relation(fields: [agentId], references: [id])
  knowledgeEntries KnowledgeEntry[]

  @@index([agentId, status])
  @@index([scene])
  @@index([createdAt])
  @@index([wechatAccountId, conversationId, customerId, createdAt])
  @@index([sourceType, sourceRouteId])
}

model KnowledgeEntry {
  id               String                @id @default(cuid())
  agentId          String?
  trainingSampleId String?
  sourceType       String
  sourceId         String?
  title            String
  content          String                @db.Text
  tags             Json?
  qualityScore     Int?
  status           String                @default("review")
  reviewer         String?
  reviewNote       String?
  reviewedAt       DateTime?
  reviewHistory    Json?
  customerId       String?
  conversationId   String?
  wechatAccountId  String?
  identityBinding  Json?
  metadata         Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  agent            CustomerServiceAgent? @relation(fields: [agentId], references: [id])
  trainingSample   TrainingSample?       @relation(fields: [trainingSampleId], references: [id])

  @@index([agentId])
  @@index([sourceType, sourceId])
  @@index([agentId, status])
  @@index([agentId, wechatAccountId, conversationId, customerId, qualityScore])
}

model RouteEvaluation {
  id                      String                @id @default(cuid())
  channel                 String
  text                    String                @db.Text
  customerId              String?
  conversationId          String?
  wechatAccountId         String?
  agentId                 String?
  agentKey                String
  scene                   String
  action                  String
  confidence              Int
  isHighValue             Boolean               @default(false)
  budget                  Json?
  missingFields           Json?
  riskFlags               Json?
  identityBinding         Json?
  sceneScore              Int                   @default(0)
  sceneScores             Json?
  matchedKeywords         Json?
  sceneDecision           Json?
  sceneClarification      Json?
  clarificationResolution Json?
  sceneMemory             Json?
  sceneAudit              Json?
  routingPolicy           Json?
  correction              Json?
  suggestedReply          String?               @db.Text
  appliedSkills           Json?
  knowledgeMatches        Json?
  replyDraft              Json?
  learningInsight         Json?
  conversionAssessment    Json?
  operationKey            String?               @unique
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  agent                   CustomerServiceAgent? @relation(fields: [agentId], references: [id])

  @@index([agentId, createdAt])
  @@index([action, createdAt])
  @@index([scene])
  @@index([wechatAccountId, conversationId, customerId, createdAt])
}
