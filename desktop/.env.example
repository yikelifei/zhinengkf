NODE_ENV=development
ALLOW_DEMO_DATA_MUTATIONS=1
API_PORT=3200
WEB_URL=http://127.0.0.1:3100
USE_LOCAL_STORE=true
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/smart_kefu
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
LOW_VALUE_AUTOMATION_ENABLED=1
LOW_VALUE_AUTOMATION_MODE=interval
LOW_VALUE_AUTOMATION_REDIS_URL=redis://127.0.0.1:6379/0
LOW_VALUE_AUTOMATION_RUN_ON_START=1
LOW_VALUE_AUTOMATION_INTERVAL_MS=15000
LOW_VALUE_AUTOMATION_SEND_QUEUE_LIMIT=100
LOW_VALUE_AUTOMATION_SEND_PER_ACCOUNT_LIMIT=10
LOCAL_STORAGE_ROOT=./storage
ZHENXI_AI_APP_URL=https://app.zhenxiai.cloud
ZHENXI_AI_SITE_URL=https://zhenxiai.cloud
ZHENXI_AI_WWW_URL=https://www.zhenxiai.cloud
DESIGN_PLATFORM_ADAPTER=art_image_local
DESIGN_PLATFORM_BASE_URL=http://127.0.0.1:3000
ACCEPTANCE_ALLOW_LOOPBACK_DESIGN_DOWNLOADS=1
# Comma-separated exact HTTPS origins allowed for standard_v1 runtime switching.
DESIGN_PLATFORM_ALLOWED_ORIGINS=
# For zhenxi_external, use the same value as Zhenxi AI ART_EXTERNAL_API_KEY.
DESIGN_PLATFORM_API_KEY=replace-with-zhenxi-art-external-api-key
DESIGN_PLATFORM_ACCESS_TOKEN=replace-with-design-platform-login-access-token
DESIGN_PLATFORM_COOKIE=art_access_token=replace; art_refresh_token=replace
DESIGN_PLATFORM_DEVICE_ID=replace-with-activated-device-id
CUSTOMER_SERVICE_PUBLIC_BASE_URL=http://127.0.0.1:3200
DESIGN_PLATFORM_CALLBACK_URL=http://127.0.0.1:3200/api/integrations/design-platform/callback
DESIGN_PLATFORM_CALLBACK_API_KEY=replace-with-callback-key
# DeepSeek 仅处理文字客服回复；客户图片先由千问等视觉模型转成文字摘要。
AI_PROVIDER_DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Only a secure common parent may share this ephemeral value with Electron and Web. Never persist it.
# DESKTOP_WEB_SESSION_PROOF=
# Local developer convenience: lets http://127.0.0.1:3100 or localhost use /api without the Electron-only cookie.
# Packaged desktop runtime forces this off.
ALLOW_LOCAL_BROWSER_WEB_API=1
PERSONAL_WECHAT_SEND=0
PERSONAL_WECHAT_BRIDGE=0
PERSONAL_WECHAT_ALLOW_UNVERIFIED_WINDOW=0
PERSONAL_WECHAT_AUTO_ENTER=0
PERSONAL_WECHAT_DRIVER=windows_uia
PERSONAL_WECHAT_ACCOUNTS_CONFIG_FILE=.runtime/personal-wechat-accounts.json
PERSONAL_WECHAT_BLOCKED_DIR=.runtime/personal-wechat-blocked
PERSONAL_WECHAT_RPA_ACCOUNT_NICKNAME=replace-with-dedicated-test-account-nickname
PERSONAL_WECHAT_RPA_TOKEN=replace-with-random-local-token
PERSONAL_WECHAT_RPA_ENDPOINT=http://127.0.0.1:3211
PERSONAL_WECHAT_RPA_CONFIG_FILE=.runtime/personal-wechat-rpa.json
PERSONAL_WECHAT_PASTE_DELAY_MS=500
PERSONAL_WECHAT_CONFIRM_DELAY_MS=1500
PERSONAL_WECHAT_SEND_TIMEOUT_MS=60000
WECHAT_WORK_CORP_ID=replace-with-wechat-work-corp-id
WECHAT_WORK_SECRET=replace-with-wechat-work-app-or-kf-secret
# 固定出口模式：桌面把所有企业微信官方 API 请求经生产服务器转发。
# 生产服务器 Nginx 必须校验同一枚独立 64 位十六进制令牌，并关闭该路径的查询串访问日志。
WECHAT_WORK_API_BASE_URL=https://kefu.example.com/wecom-api
WECHAT_WORK_API_RELAY_TOKEN=replace-with-independent-64-char-hex-token
# 生产回调服务器使用 signal_only；桌面保持 process（默认），避免服务器和桌面重复 sync_msg。
WECHAT_WORK_CALLBACK_PROCESSING_MODE=process
# Optional override. Leave empty when WECHAT_WORK_SECRET belongs to the self-built
# application authorized for both WeChat Customer Service and Customer Contact.
WECHAT_WORK_EXTERNAL_CONTACT_SECRET=
WECHAT_WORK_TOKEN=replace-with-wechat-work-callback-token
WECHAT_WORK_ENCODING_AES_KEY=replace-with-43-char-encoding-aes-key
WECHAT_WORK_OPEN_KFID=replace-with-wechat-customer-service-open-kfid
# Production server only: 64-character hexadecimal token for the read-only readiness export endpoint.
WECHAT_WORK_READINESS_EXPORT_TOKEN=
# Desktop only: exact HTTPS export endpoint and its read-only token. Never reuse INTERNAL_API_TOKEN.
WECHAT_WORK_REMOTE_READINESS_URL=
WECHAT_WORK_REMOTE_READINESS_TOKEN=
# Production server only: independent 64-character hexadecimal token for the callback event stream.
WECHAT_WORK_EVENT_STREAM_EXPORT_TOKEN=
# Desktop only: authenticated server-to-desktop callback signal stream. Never expose this token to the web UI.
WECHAT_WORK_REMOTE_EVENT_URL=
WECHAT_WORK_REMOTE_EVENT_TOKEN=
# 企业微信服务商应用授权（官方安装页扫码授权）
WECHAT_WORK_SUITE_ID=replace-with-suite-id
WECHAT_WORK_SUITE_SECRET=replace-with-suite-secret
WECHAT_WORK_SUITE_TOKEN=replace-with-suite-callback-token
WECHAT_WORK_SUITE_ENCODING_AES_KEY=replace-with-43-char-suite-encoding-aes-key
# 32 字节 Base64 或 64 位十六进制；用于加密 suite_ticket 与永久授权码
WECHAT_WORK_SUITE_STORAGE_KEY=replace-with-32-byte-base64-or-64-char-hex-key
WECHAT_WORK_SUITE_AUTHORIZATION_STORE_FILE=.runtime/wechat-work-suite-authorization.json
WECHAT_SEND_ADAPTER=dry_run
WECHAT_WORK_SEND_MAX_ATTEMPTS=3
WECHAT_WORK_SEND_RETRY_DELAY_SECONDS=30
WECHAT_WORK_AUTO_SYNC_ENABLED=0
WECHAT_WORK_AUTO_SYNC_LIMIT=100
# 回调/事件流优先；兜底轮询每轮只错峰同步少量客服账号，避免 sync_msg 45009。
WECHAT_WORK_AUTO_SYNC_ACCOUNTS_PER_RUN=1
WECHAT_WORK_AUTO_SYNC_RATE_LIMIT_BACKOFF_MS=60000
# 仅限员工内测；只允许精确身份白名单中的低风险回复自动发送。
WECHAT_INTERNAL_TEST_AUTO_REPLY_ENABLED=0
WECHAT_INTERNAL_TEST_AUTO_REPLY_WECHAT_ACCOUNT_IDS=wechat_work_employee_test
WECHAT_INTERNAL_TEST_AUTO_REPLY_CONVERSATION_IDS=conversation_employee_test
WECHAT_INTERNAL_TEST_AUTO_REPLY_CUSTOMER_IDS=customer_employee_test
HIGH_VALUE_AMOUNT_CNY=10000
DESIGN_TIMEOUT_MINUTES=20
DESIGN_DEFAULT_OUTPUT_COUNT=4
# Official billing queries use separate finance credentials; model API keys cannot replace them.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
OPENAI_ADMIN_KEY=
