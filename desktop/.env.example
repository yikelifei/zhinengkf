NODE_ENV=development
API_PORT=3200
WEB_URL=http://127.0.0.1:3100
USE_LOCAL_STORE=true
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/smart_kefu
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
LOW_VALUE_AUTOMATION_ENABLED=1
LOW_VALUE_AUTOMATION_MODE=interval
LOW_VALUE_AUTOMATION_REDIS_URL=redis://127.0.0.1:6379/0
LOW_VALUE_AUTOMATION_RUN_ON_START=1
LOW_VALUE_AUTOMATION_INTERVAL_MS=15000
LOCAL_STORAGE_ROOT=./storage
DESIGN_PLATFORM_ADAPTER=art_image_local
DESIGN_PLATFORM_BASE_URL=http://127.0.0.1:3000
# Comma-separated exact HTTPS origins allowed for standard_v1 runtime switching.
DESIGN_PLATFORM_ALLOWED_ORIGINS=
DESIGN_PLATFORM_API_KEY=replace-with-design-platform-key
DESIGN_PLATFORM_ACCESS_TOKEN=replace-with-design-platform-login-access-token
DESIGN_PLATFORM_COOKIE=art_access_token=replace; art_refresh_token=replace
DESIGN_PLATFORM_DEVICE_ID=replace-with-activated-device-id
CUSTOMER_SERVICE_PUBLIC_BASE_URL=http://127.0.0.1:3200
DESIGN_PLATFORM_CALLBACK_URL=http://127.0.0.1:3200/api/integrations/design-platform/callback
DESIGN_PLATFORM_CALLBACK_API_KEY=replace-with-callback-key
# Only a secure common parent may share this ephemeral value with Electron and Web. Never persist it.
# DESKTOP_WEB_SESSION_PROOF=
PERSONAL_WECHAT_SEND=0
PERSONAL_WECHAT_BRIDGE=0
PERSONAL_WECHAT_ALLOW_UNVERIFIED_WINDOW=0
PERSONAL_WECHAT_AUTO_ENTER=0
PERSONAL_WECHAT_DRIVER=windows_uia
PERSONAL_WECHAT_ACCOUNTS_CONFIG_FILE=.runtime/personal-wechat-accounts.json
PERSONAL_WECHAT_BLOCKED_DIR=.runtime/personal-wechat-blocked
PERSONAL_WECHAT_RPA_ACCOUNT_NICKNAME=replace-with-dedicated-test-account-nickname
PERSONAL_WECHAT_RPA_TOKEN=replace-with-random-local-token
PERSONAL_WECHAT_RPA_ENDPOINT=http://127.0.0.1:3211
PERSONAL_WECHAT_RPA_CONFIG_FILE=.runtime/personal-wechat-rpa.json
PERSONAL_WECHAT_PASTE_DELAY_MS=500
PERSONAL_WECHAT_CONFIRM_DELAY_MS=1500
PERSONAL_WECHAT_SEND_TIMEOUT_MS=60000
WECHAT_WORK_CORP_ID=replace-with-wechat-work-corp-id
WECHAT_WORK_SECRET=replace-with-wechat-work-app-or-kf-secret
WECHAT_WORK_TOKEN=replace-with-wechat-work-callback-token
WECHAT_WORK_ENCODING_AES_KEY=replace-with-43-char-encoding-aes-key
WECHAT_WORK_OPEN_KFID=replace-with-wechat-customer-service-open-kfid
WECHAT_SEND_ADAPTER=dry_run
WECHAT_WORK_SEND_MAX_ATTEMPTS=3
WECHAT_WORK_SEND_RETRY_DELAY_SECONDS=30
HIGH_VALUE_AMOUNT_CNY=10000
DESIGN_TIMEOUT_MINUTES=20
DESIGN_DEFAULT_OUTPUT_COUNT=6
