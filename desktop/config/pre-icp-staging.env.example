# Copy this file to a secret location outside the repository and fill real values there.
# During ICP filing, keep every service on loopback/private networking and do not enable real sending.

NODE_ENV=staging
ALLOW_DEMO_DATA_MUTATIONS=0
USE_LOCAL_STORE=false
API_PORT=3200
WEB_PORT=3100
WEB_URL=http://127.0.0.1:3100
STAGING_API_BASE=http://127.0.0.1:3200/api

# Required: exactly 64 hexadecimal characters. Generate with a cryptographic random generator.
INTERNAL_API_TOKEN=

DATABASE_PROVIDER=postgresql
# Example shape only: postgresql://smart_kefu_app:<password>@127.0.0.1:5432/smart_kefu_staging
DATABASE_URL=

LOW_VALUE_AUTOMATION_ENABLED=1
LOW_VALUE_AUTOMATION_MODE=durable
LOW_VALUE_AUTOMATION_RUN_ON_START=1
LOW_VALUE_AUTOMATION_PROCESS_SEND_QUEUE=0
# Example shape only: redis://smart_kefu_queue:<password>@127.0.0.1:6379/0
LOW_VALUE_AUTOMATION_REDIS_URL=

# SSH-tunnel-only operator preview. Change to 0 before any public Web exposure.
ALLOW_LOCAL_BROWSER_WEB_API=1

WECHAT_PRODUCT_MODE=enterprise_wechat_only
WECHAT_SEND_ADAPTER=dry_run
WECHAT_WORK_API_BASE_URL=https://qyapi.weixin.qq.com
CUSTOMER_SERVICE_PUBLIC_BASE_URL=
WECHAT_WORK_CORP_ID=
WECHAT_WORK_SECRET=
WECHAT_WORK_TOKEN=
WECHAT_WORK_ENCODING_AES_KEY=
WECHAT_WORK_OPEN_KFID=

PERSONAL_WECHAT_SEND=0
PERSONAL_WECHAT_BRIDGE=0

# art_image_local requires Zhenxi AI on the same machine. It may remain BLOCKED on a server-only preview.
DESIGN_PLATFORM_ADAPTER=art_image_local
DESIGN_PLATFORM_BASE_URL=http://127.0.0.1:3000
DESIGN_PLATFORM_ACCESS_TOKEN=
DESIGN_PLATFORM_COOKIE=
DESIGN_PLATFORM_API_KEY=
DESIGN_PLATFORM_DEVICE_ID=

# Configure at least the current primary provider or one enabled fallback provider.
CUSTOM_API_KEY=
CUSTOM_API_BASE=
CUSTOM_API_MODEL=
ZHIPU_API_KEY=
ZHIPU_BASE_URL=
ZHIPU_MODEL=
