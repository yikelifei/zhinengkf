# Smart Bot - Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# Reuse Zhenxi AI's current text-model provider, model and API key without copying the secret.
# Relative paths are resolved from config/settings.yaml. Override this when the Zhenxi AI workspace moves.
ZHENXI_AI_TEXT_ENV_PATH=../../art image-new/web/.env.local

# Economy tier: enable one or more matching providers in config/settings.yaml.
# SiliconFlow (OpenAI-compatible)
SILICONFLOW_API_KEY=your-siliconflow-api-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3-8B

# Alibaba Cloud Model Studio / DashScope (China Beijing)
DASHSCOPE_API_KEY=your-dashscope-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.5-flash

# Volcano Engine Ark. Model IDs are account/region specific; copy the exact ID from the Ark console.
VOLCENGINE_API_KEY=your-volcengine-api-key-here
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_MODEL=your-ark-model-or-endpoint-id

# Quality tier: Kimi API Platform
MOONSHOT_API_KEY=your-moonshot-api-key-here
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=kimi-k2.6

# GeekNow API (primary)
GEEKNOW_API_KEY=sk-your-geeknow-key-here
GEEKNOW_BASE_URL=https://api.geeknow.ai/v1
GEEKNOW_MODEL=gpt-4o-mini

# Custom API (optional OpenAI-compatible backup)
CUSTOM_API_KEY=sk-your-custom-api-key-here
CUSTOM_API_BASE=https://api.example.com/v1
CUSTOM_API_MODEL=gpt-4o-mini

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Zhipu GLM
ZHIPU_API_KEY=your-zhipu-api-key-here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# One-key AI provider presets. The desktop model center writes these values
# automatically; manual editing is optional. Never commit real keys.
# AI_PROVIDER_OPENAI_ENABLED=false
# AI_PROVIDER_ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# AI_PROVIDER_GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# AI_PROVIDER_XAI_ENABLED=false
XAI_API_KEY=
XAI_MODEL=grok-4.5
# AI_PROVIDER_GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# AI_PROVIDER_MISTRAL_ENABLED=false
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# AI_PROVIDER_TOGETHER_ENABLED=false
TOGETHER_API_KEY=
TOGETHER_MODEL=Qwen/Qwen3.5-9B
# AI_PROVIDER_OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# AI_PROVIDER_QIANFAN_ENABLED=false
QIANFAN_API_KEY=
QIANFAN_MODEL=ernie-4.0-turbo-8k
# AI_PROVIDER_HUNYUAN_ENABLED=false
HUNYUAN_API_KEY=
HUNYUAN_MODEL=hunyuan-turbos-latest
# AI_PROVIDER_MINIMAX_ENABLED=false
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
# AI_PROVIDER_STEPFUN_ENABLED=false
STEPFUN_API_KEY=
STEPFUN_MODEL=step-3.5-flash
# AI_PROVIDER_SILICONFLOW_ENABLED=false
# AI_PROVIDER_DASHSCOPE_ENABLED=false
# AI_PROVIDER_VOLCENGINE_ENABLED=false
# AI_PROVIDER_MOONSHOT_ENABLED=false
# AI_PROVIDER_ZHIPU_ENABLED=false
# AI_PROVIDER_DEEPSEEK_ENABLED=false
